# Copy to .env and fill in what you need. Runtrail only reads
# RUNTRAIL_STORE_DSN itself (see `runtrail ui`); the rest are consumed by the
# libraries a given component wraps (LiteLLMAdapter -> litellm, etc.) — set
# only the ones the extras/components you're using actually need.

# --- Storage (runtrail ui) ---
# Set to switch the Web UI from the default SQLiteStore to PostgresStore.
# Unset (or empty) keeps the zero-config SQLite default.
RUNTRAIL_STORE_DSN=postgresql://runtrail:runtrail@localhost:5432/runtrail

# --- Model gateway (LiteLLMAdapter / LLMJudge / gateway_kwargs) ---
# Direct provider calls:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Or point at a One-API / OpenAI-compatible proxy instead of a provider directly:
# LiteLLMAdapter(model, api_base="https://your-one-api-host/v1", api_key="...")

# --- Postgres integration tests (tests/integration/test_postgres_store.py) ---
# Only needed to run that suite locally; CI provisions its own Postgres service.
RUNTRAIL_TEST_POSTGRES_DSN=host=localhost port=5432 user=runtrail password=runtrail dbname=runtrail_test
